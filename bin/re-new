#!/usr/bin/env bash
# re-new GAME [TEMPLATE [MODNAME]] — create a target folder, optionally with a mod from a template.
set -euo pipefail
source "$(dirname "$(realpath "$0")")/../lib/common.sh"

[[ $# -ge 1 && $# -le 3 ]] || usage_die "usage: re-new GAME [TEMPLATE [MODNAME]]"
game="$1" template="${2:-}" modname="${3:-${2:-}}"
[[ -n "$game" && "$game" != */* && "$game" != .* ]] || usage_die "game name must be a plain folder name, got '$game'"
[[ -z "$modname" || ( "$modname" != */* && "$modname" != .* ) ]] || usage_die "mod name must be a plain folder name, got '$modname'"
target="$RE_HOME/targets/$game"

mkdir -p "$target"/{ghidra,dumps,mods}
if [[ ! -f "$target/notes.md" ]]; then
    cat > "$target/notes.md" <<NOTES
# $game

Started $(date +%F).

## Binary

Path, version, engine.

## Findings

Address, RVA, name, how you know.

## Offsets

Pointer chains and patterns that tools and mods rely on.

## Mods

What lives in mods/ and how it is installed.
NOTES
fi
echo "$target"

[[ -n "$template" ]] || exit 0
src="$RE_ENV/templates/$template"
if [[ ! -d "$src" ]]; then
    echo "error: unknown template '$template'. Available:" >&2
    ls "$RE_ENV/templates" >&2
    exit 2
fi
dest="$target/mods/$modname"
[[ -e "$dest" ]] && die "$dest already exists"
# copy the template without build output or virtualenvs (tar is in base)
tmp="$(mktemp -d "$target/mods/.$modname.XXXXXX")"
tar -C "$src" --exclude=build --exclude=target --exclude=.venv --exclude=bin --exclude=obj \
    --exclude=__pycache__ --exclude=.pytest_cache -cf - . | tar -C "$tmp" -xf - \
    || { rm -rf "$tmp"; die "copying $template failed"; }
mv "$tmp" "$dest"
echo "$dest"
