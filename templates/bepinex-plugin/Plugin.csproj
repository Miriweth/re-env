<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>ExamplePlugin</AssemblyName>
    <RootNamespace>ExamplePlugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- pass the game folder: dotnet build -c Release -p:GameDir=/path/to/game -->
    <GameDir Condition="'$(GameDir)' == ''"></GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2019.4.*" IncludeAssets="compile" />
  </ItemGroup>

  <!-- game assemblies, only when a game folder is given. The glob has to sit in
       Include (MSBuild expands wildcards there, not in HintPath), and a folder
       without the assembly fails the build instead of silently dropping it. -->
  <ItemGroup Condition="'$(GameDir)' != ''">
    <GameAssembly Include="$(GameDir)/*_Data/Managed/Assembly-CSharp.dll" />
    <Reference Include="@(GameAssembly)">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireGameAssembly" BeforeTargets="CoreCompile" Condition="'$(GameDir)' != ''">
    <Error Condition="'@(GameAssembly)' == ''" Text="No Assembly-CSharp.dll under $(GameDir)/*_Data/Managed. Check -p:GameDir." />
  </Target>

</Project>
