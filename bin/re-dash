#!/usr/bin/env python3
"""re-dash [--port N] — station on 127.0.0.1: dashboard of ~/re plus a token-guarded API to run claude per game."""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from station import server  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description="Dashboard and run station for ~/re on 127.0.0.1.")
    ap.add_argument("--port", type=int, default=8780, help="port to listen on, 0 picks a free one (default 8780)")
    args = ap.parse_args()
    server.serve(args.port)


if __name__ == "__main__":
    main()
